# Lab 3 - Task 3: weighted graph, UCS vs BFS
# Weighted extension (Section 3.7): original corridors plus C -> G. All costs are nonnegative.
# The weights below are chosen for this lab to match the manual's stated result
# (BFS: A-C-G, cost 12; UCS: A-B-E-G, cost 3). They are lab assumptions, not real data.
import heapq
from collections import deque

weighted = {
    "A": [("B", 1), ("C", 5)],
    "B": [("D", 2), ("E", 1)],
    "C": [("F", 2), ("G", 7)],
    "D": [],
    "E": [("G", 1)],
    "F": [],
    "G": [],
}


def ucs(start, goal):
    frontier = [(0, 0, start, [start])]
    counter = 1
    best = {}
    order = []
    while frontier:
        cost, _, node, path = heapq.heappop(frontier)
        if node in best and best[node] <= cost:
            continue
        best[node] = cost
        order.append((node, cost))
        if node == goal:
            return path, cost, order
        for nxt, w in weighted[node]:
            heapq.heappush(frontier, (cost + w, counter, nxt, path + [nxt]))
            counter += 1
    return None, None, order


def bfs(start, goal):
    q = deque([(start, [start])])
    seen = {start}
    order = []
    while q:
        node, path = q.popleft()
        order.append(node)
        if node == goal:
            return path, order
        for nxt, _ in weighted[node]:
            if nxt not in seen:
                seen.add(nxt)
                q.append((nxt, path + [nxt]))
    return None, order


def path_cost(path):
    # independent re-computation of the edge weights along a path
    total = 0
    for a, b in zip(path, path[1:]):
        total += dict(weighted[a])[b]
    return total


print("Edge weights:")
for node, edges in weighted.items():
    for nxt, w in edges:
        print(f"  {node} -> {nxt} : {w}")

path, cost, order = ucs("A", "G")
print()
print("UCS path:", path, "| returned cost:", cost, "| independent cost:", path_cost(path), "| edges:", len(path) - 1)
print("UCS processing order (node, cost):", order)

bpath, border = bfs("A", "G")
print()
print("BFS path:", bpath, "| cost:", path_cost(bpath), "| edges:", len(bpath) - 1)
print("BFS processing order:", border)