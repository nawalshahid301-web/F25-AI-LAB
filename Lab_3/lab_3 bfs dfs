# Lab 3 - Task 1: BFS and DFS with frontier traces (original A-G graph)
# Successor-list order is the tie-breaking order. Goal processing is included in the visit order.
from collections import deque

graph = {"A": ["B", "C"], "B": ["D", "E"], "C": ["F"],
         "D": [], "E": ["G"], "F": [], "G": []}


def bfs(start, goal, g=graph, trace=False):
    q = deque([(start, [start])])
    seen = {start}
    order = []
    while q:
        node, path = q.popleft()
        order.append(node)
        if trace:
            print(f"  process {node} | path={path} | queue after: {[n for n, _ in q]}", end="")
        if node == goal:
            if trace:
                print("  -> GOAL")
            return path, order
        for n in g[node]:
            if n not in seen:
                seen.add(n)
                q.append((n, path + [n]))
        if trace:
            print(f" -> {[n for n, _ in q]}")
    return None, order


def dfs(start, goal, g=graph, trace=False):
    stack = [(start, [start])]
    seen = set()
    order = []
    while stack:
        node, path = stack.pop()
        if node in seen:
            continue
        seen.add(node)
        order.append(node)
        if node == goal:
            if trace:
                print(f"  process {node} | path={path}  -> GOAL")
            return path, order
        for n in reversed(g[node]):
            stack.append((n, path + [n]))
        if trace:
            print(f"  process {node} | path={path} | stack after (top is last): {[n for n, _ in stack]}")
    return None, order


print("BFS trace")
p, o = bfs("A", "G", trace=True)
print("BFS path:", p, "| visit order:", o)
print()
print("DFS trace")
p, o = dfs("A", "G", trace=True)
print("DFS path:", p, "| visit order:", o)

print()
print("Edge cases")
print("start == goal  BFS:", bfs("A", "A")[0], "| DFS:", dfs("A", "A")[0])
print("unreachable    BFS:", bfs("D", "G")[0], "| DFS:", dfs("D", "G")[0])
cyc = {"A": ["B"], "B": ["A", "C"], "C": []}
print("cycle graph    BFS:", bfs("A", "C", cyc)[0], "| DFS:", dfs("A", "C", cyc)[0])